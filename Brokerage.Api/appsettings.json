{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BrokerageDb": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "cleartrade-api",
    "Audience": "cleartrade-clients",
    "ExpiresMinutes": 60
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 100,
    "AuthPermitPerMinute": 10
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
